# Copy to .env.local for local dev (git-ignored via *.local) and set the same
# variables in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. NEVER prefix these with VITE_ (that would ship them to the browser).
# Full setup guide: docs/free-hooks-mailerlite-setup.md

# MailerLite API token (MailerLite → Integrations → API → Generate new token). SECRET.
MAILERLITE_API_TOKEN=

# Numeric group IDs: group named "CONVRT — SaaS Hooks" / "CONVRT — E-commerce Hooks"
MAILERLITE_GROUP_SAAS_ID=
MAILERLITE_GROUP_ECOMMERCE_ID=

# OPTIONAL: group that only people who tick the "tips and offers" box are added to
MAILERLITE_GROUP_MARKETING_ID=

# /risk-free-trial applications: group named "CONVRT — Free Video Applications".
# Needs custom fields (website, business_type, ad_spend, videos_per_month,
# video_type, timeline, ongoing_interest, brief). See docs/risk-free-application-setup.md
MAILERLITE_GROUP_RISK_FREE_ID=

# OPTIONAL: email alert to the owner for every /risk-free-trial application and every /free-hooks signup
# (Resend, https://resend.com).
# Nothing is sent unless RESEND_API_KEY is set. SECRET.
RESEND_API_KEY=
# Defaults: to mohamed@convrt.studio, from "CONVRT Site <onboarding@resend.dev>" (Resend's test sender only
# delivers to the Resend account owner's address; verify convrt.studio in Resend to use your own domain).
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# /referrals (Referral Partner Program): group named "CONVRT — Referral Partner Applications".
# Needs custom fields (partner_type, referral_program, partner_company, partner_website,
# referred_company, referred_website, referral_notes). See docs/referral-program-setup.md
# The owner email alert uses the same RESEND_API_KEY / NOTIFY_EMAIL_TO / NOTIFY_EMAIL_FROM as above.
MAILERLITE_GROUP_REFERRALS_ID=

# ── Creator portfolio onboarding (/creator-onboarding, /creator-admin) ─────────────────────────────────────
# Full setup guide: docs/creator-onboarding-setup.md. All SECRET. Never prefix with VITE_.
# Cloudflare Stream (private direct creator uploads). API token needs permission "Stream: Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Database: Upstash Redis. Vercel → Storage → Marketplace → Upstash Redis injects KV_REST_API_URL and
# KV_REST_API_TOKEN automatically (or set UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN yourself).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Owner review page sign-in. Password: 16+ characters (use a long random passphrase). Session secret: 32+ random characters.
CREATOR_ADMIN_PASSWORD=
CREATOR_ADMIN_SESSION_SECRET=
# Owner email alerts reuse RESEND_API_KEY / NOTIFY_EMAIL_TO / NOTIFY_EMAIL_FROM above.
# Local development only: CREATOR_STORE=memory (in-memory store, ignored on Production) and, to run without real
# Cloudflare, CLOUDFLARE_API_BASE / CLOUDFLARE_PLAYBACK_BASE pointing at tests/helpers/mockCloudflareStream.mjs.
# Daily retention clean-up (vercel.json "crons" -> /api/creator-cron). 16+ random characters. Vercel sends it as
# "Authorization: Bearer <value>" to the cron endpoint; without it the job refuses to run. Production only (crons do not run on Previews).
CRON_SECRET=

# ── Analytics (Google Tag Manager + GA4, with Google Consent Mode v2) ─────────────────────────────────────
# Full setup guide: docs/analytics-and-consent.md. This ID is PUBLIC by nature (it is in the page once loaded), but it is not committed:
# set it in Vercel → Settings → Environment Variables (Production and, for testing, Preview). It is a BUILD-time variable, so redeploy after changing it.
# Leave it empty and the site loads nothing from Google and shows no cookie banner. The GA4 measurement ID is NOT set here: it lives inside the GTM container.
VITE_GTM_ID=
