# Copy to .env.local for local dev (git-ignored via *.local) and set the same
# variables in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. NEVER prefix these with VITE_ (that would ship them to the browser).
# Full setup guide: docs/free-hooks-mailerlite-setup.md

# MailerLite API token (MailerLite → Integrations → API → Generate new token). SECRET.
MAILERLITE_API_TOKEN=

# Numeric group IDs: group named "CONVRT — SaaS Hooks" / "CONVRT — E-commerce Hooks"
MAILERLITE_GROUP_SAAS_ID=
MAILERLITE_GROUP_ECOMMERCE_ID=

# OPTIONAL: group that only people who tick the "tips and offers" box are added to
MAILERLITE_GROUP_MARKETING_ID=

# /risk-free-trial applications: group named "CONVRT — Free Video Applications".
# Needs custom fields (website, business_type, ad_spend, videos_per_month,
# video_type, timeline, ongoing_interest, brief). See docs/risk-free-application-setup.md
MAILERLITE_GROUP_RISK_FREE_ID=

# OPTIONAL: email alert to the owner for every /risk-free-trial application and every /free-hooks signup
# (Resend, https://resend.com).
# Nothing is sent unless RESEND_API_KEY is set. SECRET.
RESEND_API_KEY=
# Defaults: to mohamed@convrt.studio, from "CONVRT Site <onboarding@resend.dev>" (Resend's test sender only
# delivers to the Resend account owner's address; verify convrt.studio in Resend to use your own domain).
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
