{
  "regions": [
    "fra1"
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "convrt.studio"
        }
      ],
      "destination": "https://www.convrt.studio/$1",
      "permanent": true
    },
    {
      "source": "/creative-testing-sprint",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/our-work",
      "destination": "/creator-showcase",
      "permanent": true
    },
    {
      "source": "/case-studies",
      "has": [{ "type": "query", "key": "case", "value": "elyon" }],
      "destination": "/case-studies/elyon",
      "permanent": true
    },
    {
      "source": "/:lang(es|fr|ar)/case-studies",
      "has": [{ "type": "query", "key": "case", "value": "elyon" }],
      "destination": "/:lang/case-studies/elyon",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "^.*\\.vercel\\.app$" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/project-application",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/:lang(es|fr|ar)/project-application",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/blog",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/creator-onboarding/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/creator-admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/creator-cron",
      "schedule": "17 3 * * *"
    }
  ]
}
